{
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tsconfig/node26": "^26.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lefthook": "^2.2.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-monkey": "^8.1.1"
  },
  "scripts": {
    "build": "npm run typecheck && vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "ci": "biome ci --error-on-warnings && npm run lint:structure && npm run typecheck",
    "dev": "node scripts/dev.mjs",
    "format": "biome check --write --error-on-warnings",
    "lint:structure": "node scripts/check_project_structure.cjs",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "release": "git tag $(date '+%Y%m%d') && git push --tags"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "glob": "13.0.6",
    "minimatch": "10.2.5",
    "babel-plugin-istanbul": "8.0.0",
    "test-exclude": "8.0.0"
  }
}
