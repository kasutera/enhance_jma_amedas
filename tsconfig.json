{
    "extends": "@tsconfig/node24/tsconfig.json",
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*",
        "vite.config.mts",
        "jest.config.ts"
    ],
    "exclude": ["src/**/*.test.ts"]
}
